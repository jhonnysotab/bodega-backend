# Copia este archivo a ".env" (mismo folder) y rellena los valores reales.
# NUNCA subas el ".env" real a git (ya está en .gitignore).

# Contraseña de MySQL root — invéntate una larga y guárdala en un gestor de contraseñas.
DB_PASSWORD=cambia_esto_por_algo_largo_y_unico

# Secreto para firmar los JWT — mínimo 32 caracteres, invéntate uno random.
JWT_SECRET=cambia_esto_por_otro_secreto_largo_y_random

# Dominio gratis de DuckDNS que apunta a la IP pública de esta VM (ver DEPLOY.md).
DUCKDNS_DOMAIN=tu-subdominio.duckdns.org

# URL(s) del frontend en Vercel/Cloudflare Pages, separadas por coma, SIN slash al final.
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# Opcional: API key de Anthropic para la importación de productos por foto de factura.
# Déjala vacía si todavía no la vas a usar.
ANTHROPIC_API_KEY=
